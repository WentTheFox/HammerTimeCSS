---
import '../../../dist/hammertime.css';
import '../styles/docs.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Documentation and live demo for HammerTimeCSS, the HTML/CSS-only design framework extracted from HammerTime." />
  </head>
  <body>
    <slot />
  </body>
</html>
